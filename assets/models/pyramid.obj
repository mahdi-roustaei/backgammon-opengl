# Simple pyramid model
# Created for CG1 project

v  0.0  1.0  0.0
v -0.5  0.0  0.5
v  0.5  0.0  0.5
v  0.5  0.0 -0.5
v -0.5  0.0 -0.5

vt 0.5 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 0.0 1.0
vt 1.0 1.0

vn  0.0  0.5  1.0
vn  1.0  0.5  0.0
vn  0.0  0.5 -1.0
vn -1.0  0.5  0.0
vn  0.0 -1.0  0.0

# Front side
f 1/1/1 2/2/1 3/3/1

# Right side
f 1/1/2 3/2/2 4/3/2

# Back side
f 1/1/3 4/2/3 5/3/3

# Left side
f 1/1/4 5/2/4 2/3/4

# Bottom
f 2/2/5 5/4/5 4/5/5
f 2/2/5 4/5/5 3/3/5
